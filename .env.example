# Copy to .env (git-ignored) on the deployment server and fill in.
# docker-compose reads this via env_file.

# --- data source ---
# akshare = free web scraping (often BLOCKED on cloud/datacenter IPs);
# tushare = token API (recommended on servers); mock = offline demo.
FINBOT_SOURCE=tushare          # akshare | tushare | mock
# Tushare token (register at https://tushare.pro). Needed when FINBOT_SOURCE=tushare.
TUSHARE_TOKEN=

# --- Claude agent layer (optional; needed only when FINBOT_WITH_LLM=1) ---
FINBOT_WITH_LLM=1
ANTHROPIC_API_KEY=sk-ant-...    # from console.anthropic.com

# --- report push: choose ONE channel ---
FINBOT_NOTIFY=none              # none | wecom | serverchan | telegram

# WeChat Work group robot:
# FINBOT_NOTIFY=wecom
# WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxxxx

# Server酱 (sct):
# FINBOT_NOTIFY=serverchan
# SERVERCHAN_SENDKEY=SCTxxxxxxxx

# Telegram:
# FINBOT_NOTIFY=telegram
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789

# --- testing ---
# FINBOT_SKIP_TRADING_GUARD=1   # run even on weekends/holidays
# FINBOT_DATE=2026-06-02        # pin a date instead of "today"
